---
// Bookmarks component
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  interface Bookmark {
    url: string;
    slug: string;
  }

  const STORAGE_KEY = 'mona-bookmarks';

  function normalizeUrl(input: string): string {
    const trimmed = input.trim();
    if (!trimmed) return '';
    const hasScheme = /^https?:\/\//i.test(trimmed);
    const withScheme = hasScheme ? trimmed : `https://${trimmed}`;
    try {
      const parsed = new URL(withScheme);
      return parsed.toString();
    } catch {
      return withScheme;
    }
  }

  function generateSlug(): string {
    const chars = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
    let id = '';
    for (let i = 0; i < 4; i++) {
      id += chars[Math.floor(Math.random() * chars.length)];
    }
    return `mona-${id}`;
  }

  function parseBookmarks(raw: string | null): Bookmark[] {
    if (!raw) return [];
    try {
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [];
      return parsed.filter((item): item is Bookmark =>
        Boolean(item && typeof item === 'object' && typeof item.url === 'string' && typeof item.slug === 'string' && item.url && item.slug)
      );
    } catch {
      return [];
    }
  }

  function getBookmarks(): Bookmark[] {
    try {
      return parseBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function saveBookmarks(bookmarks: Bookmark[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      // Ignore storage errors
    }
  }

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const urlInput = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list') as HTMLUListElement | null;
  const emptyState = document.getElementById('empty-state') as HTMLElement | null;
  const listHeader = document.getElementById('list-header') as HTMLElement | null;
  const clearAllBtn = document.getElementById('clear-all') as HTMLButtonElement | null;

  function render() {
    const bookmarks = getBookmarks();
    if (!list || !emptyState || !listHeader) return;

    if (bookmarks.length === 0) {
      emptyState.hidden = false;
      listHeader.hidden = true;
      list.innerHTML = '';
      return;
    }

    emptyState.hidden = true;
    listHeader.hidden = false;
    list.innerHTML = '';

    for (const bm of bookmarks) {
      const li = document.createElement('li');
      li.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bm.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bm.url;

      const sep = document.createTextNode(' :: ');

      const badge = document.createElement('span');
      badge.className = 'slug';
      badge.textContent = bm.slug;

      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'copy';
      copyBtn.textContent = 'Copy';
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bm.slug);
          copyBtn.textContent = 'Copied!';
          setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
        } catch {
          // fallback
        }
      });

      li.appendChild(link);
      li.appendChild(sep);
      li.appendChild(badge);
      li.appendChild(copyBtn);
      list.appendChild(li);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!urlInput) return;
    const raw = urlInput.value;
    const normalized = normalizeUrl(raw);
    if (!normalized) return;

    const slug = generateSlug();
    const current = getBookmarks();
    current.unshift({ url: normalized, slug });
    saveBookmarks(current);
    urlInput.value = '';
    render();
  });

  clearAllBtn?.addEventListener('click', () => {
    if (confirm('Clear all bookmarks?')) {
      saveBookmarks([]);
      render();
    }
  });

  render();
</script>
